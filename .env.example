# Copy to .env and fill in. Never commit .env.
# Token from @BotFather, format <id>:<secret>. Use a separate test bot while the old bot still runs
# (two processes polling one token get 409 Conflict).
BOT_TOKEN=
BOT_NAME=Home IoT

# Data files (relative paths resolve against the directory this .env file is in)
DEVICES_PATH=devices.json
COMMANDS_PATH=commands.json   # ignored in Docker: the image sets /app/commands.json
USERS_PATH=users.json
STATE_DIR=state
LOG_DIR=logs

TZ_NAME=Asia/Singapore
DISCOVER_TIMEOUT=5
LOG_LEVEL=INFO

# on: Mitsubishi aircons get full-state frames built by the bot (On = room preset)
# off: aircons send the captured codes from commands.json, as v1 did. Restart after changing.
AC_ENCODER=on

# The LLM server as the Pi sees it (SSH tunnel to the PC): the chat assistant and /stats.
LLM_URL=http://127.0.0.1:8001
# Chat assistant kill switch (off: free text gets a one-line reply)
LLM_ENABLED=on
# llama-server slot the bot uses (slot 0 is left for the owner); -1 = any free slot
LLM_SLOT=1

# Home for /outside and the assistant's weather answers: one of NEA's 47 forecast areas
# (Bedok, City, Toa Payoh, ...) and the air quality regions to show (north, south, east, west, central)
OUTSIDE_AREA=City
OUTSIDE_REGIONS=central
# Who may approve and remove users (/adduser, /user): comma list of user ids. Empty = everyone approved
ADMIN_IDS=
# Presence (/phone): look for paired phones on the home Wi-Fi. off = never probe the network
PRESENCE=on
# The home Wi-Fi network; empty = the Pi's own /24 (e.g. 192.168.1.0/24)
PRESENCE_SUBNET=
