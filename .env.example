# Copy to .env and fill in. Never commit .env.
# Token from @BotFather, format <id>:<secret>. Use a separate test bot while the old bot still runs
# (two processes polling one token get 409 Conflict).
BOT_TOKEN=
BOT_NAME=Home IoT

# Data files (relative paths resolve against the directory this .env file is in)
DEVICES_PATH=devices.json
COMMANDS_PATH=commands.json   # ignored in Docker: the image sets /app/commands.json
USERS_PATH=users.json
STATE_DIR=state
LOG_DIR=logs

TZ_NAME=Asia/Singapore
DISCOVER_TIMEOUT=5
LOG_LEVEL=INFO

# on: Mitsubishi aircons get full-state frames built by the bot (On = room preset)
# off: aircons send the captured codes from commands.json, as v1 did. Restart after changing.
AC_ENCODER=on
